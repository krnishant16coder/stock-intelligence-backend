# Copy to .env (or export vars) before running. Never commit real keys.
# LOCAL (MailHog): use values below as-is.
# PROD Cloud Run + Neon + Gmail: see comments for overrides.

# --- Database: Neon (pooled) ---
# Local: jdbc:postgresql://localhost:5432/stockintel
# Neon prod example (get from Neon dashboard > Connection Details > Pooled, or `neon connection-string --pooled`):
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxx-pooler.ap-south-1.aws.neon.tech/stockintel?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stockintel
SPRING_DATASOURCE_USERNAME=stockintel
SPRING_DATASOURCE_PASSWORD=stockintel

# Market data: pick provider + key (free tiers; verify NSE/BSE coverage + limits)
APP_MARKET_DATA_PROVIDER=alphavantage
ALPHAVANTAGE_API_KEY=your_key_here
TWELVEDATA_API_KEY=your_key_here

# News: pick provider + key (do not scrape publishers)
APP_NEWS_PROVIDER=newsapi
NEWSAPI_API_KEY=your_key_here
GNEWS_API_KEY=your_key_here
NEWSDATA_API_KEY=your_key_here

# AI: any OpenAI-compatible endpoint
APP_AI_PROVIDER=openai
AI_API_KEY=your_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Free-tier TPM guards: fewer + shorter news keeps Groq 8k TPM happy
AI_MAX_NEWS_FOR_AI=3
AI_MIN_INTERVAL_MS=12000
AI_MAX_TOKENS=500
# Strict JSON output (response_format). Auto-disabled for models without JSON
# mode (e.g. Groq gpt-oss); force off with AI_JSON_MODE=false if your model 400s.
AI_JSON_MODE=true
# Free alternatives (same code, just swap these three):
# Groq higher burst: AI_BASE_URL=https://api.groq.com/openai/v1 AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct (30k TPM)
# Gemini free: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ AI_MODEL=gemini-2.0-flash

# Scheduling + notifications
APP_SCHEDULING_ENABLED=true
# Daily market-close digest (16:00 IST Mon-Fri, whole portfolio, always mailed)
EOD_DIGEST_CRON=0 0 16 * * MON-FRI
# Midday MEDIUM-signals roundup (13:00 IST Mon-Fri, silent when empty)
MEDIUM_ROUNDUP_CRON=0 0 13 * * MON-FRI
APP_NOTIFICATIONS_ENABLED=true
NOTIFICATION_EMAIL_TO=you@gmail.com
# Local MailHog: stock-intelligence@localhost. Gmail prod: MUST equal your Gmail address.
NOTIFICATION_EMAIL_FROM=stock-intelligence@localhost
# --- Mail: local MailHog vs Gmail App Password ---
# Local (default below): localhost:1025, no auth
# Gmail prod: SPRING_MAIL_HOST=smtp.gmail.com SPRING_MAIL_PORT=587 SPRING_MAIL_USERNAME=you@gmail.com SPRING_MAIL_PASSWORD=<16-char-app-password> SPRING_MAIL_AUTH=true SPRING_MAIL_STARTTLS=true
# Gmail setup: Google Account > Security > 2-Step Verification ON > App passwords > Mail > Generate.
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_AUTH=false
SPRING_MAIL_STARTTLS=false
