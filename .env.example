# Copy to .env (or export vars) before running. Never commit real keys.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stockintel
SPRING_DATASOURCE_USERNAME=stockintel
SPRING_DATASOURCE_PASSWORD=stockintel

# Market data: pick provider + key (free tiers; verify NSE/BSE coverage + limits)
APP_MARKET_DATA_PROVIDER=alphavantage
ALPHAVANTAGE_API_KEY=your_key_here
TWELVEDATA_API_KEY=your_key_here

# News: pick provider + key (do not scrape publishers)
APP_NEWS_PROVIDER=newsapi
NEWSAPI_API_KEY=your_key_here
GNEWS_API_KEY=your_key_here

# AI: any OpenAI-compatible endpoint
APP_AI_PROVIDER=openai
AI_API_KEY=your_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Scheduling + notifications
APP_SCHEDULING_ENABLED=true
APP_NOTIFICATIONS_ENABLED=true
NOTIFICATION_EMAIL_TO=you@example.com
NOTIFICATION_EMAIL_FROM=stock-intelligence@localhost
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
